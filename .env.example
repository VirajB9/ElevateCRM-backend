# Spring
SPRING_PROFILES_ACTIVE=prod

# MongoDB (Standalone / Custom URI)
SPRING_DATA_MONGODB_URI=mongodb://username:password@host:27017/database

# MongoDB Docker Compose Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secretpassword
MONGO_DATABASE=digital_marketing_agency

# JWT
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Owner Bootstrap
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=replace-with-a-secure-initial-password
OWNER_PHONE_NUMBER=9999999999

# Server
PORT=8080
